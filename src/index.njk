---
layout: layouts/base.njk
title: Home
permalink: /
---
<section class="hero">
  <div class="wrap">
    <div class="hero-kicker">
      <span class="dot"></span>
      <span class="eyebrow">Cinematographer &amp; Colorist — Coimbatore</span>
    </div>
    <h1>Frames shot on set, <em>finished</em> in the grade.</h1>
    <p class="lede">
      I work across corporate films, brand content, and live broadcast — carrying a
      project from camera to final color, or stepping in for either half on its own.
    </p>
    <div class="hero-actions">
      <a class="btn primary" href="/work/">View Work</a>
      <a class="btn ghost" href="/contact/">Get in Touch</a>
    </div>

    <div class="reel-frame">
      <div class="frame-label">
        <span>SHOWREEL — 2026</span>
        <span>SONY FX3 / RED KOMODO</span>
      </div>
      <div class="video-aspect">
        <iframe
          src="{{ site.reel_embed }}"
          title="Sharun E M — Showreel"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <h2>Recent Stills</h2>
      <span class="count">Photos to be added</span>
    </div>
    <div class="stills-grid">
      {% for i in range(0, 4) %}
      <div class="still">
        <div class="placeholder">STILL {{ (i + 1) }}<br>PENDING UPLOAD</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <h2>Selected Work</h2>
      <span class="count">{{ collections.projects.length }} projects</span>
    </div>
    <div class="project-grid">
      {% for project in collections.projects | reverse %}
        {% if loop.index <= 4 %}
        <article class="project-card">
          <div class="project-still">
            {% if project.data.image %}
              <img src="{{ project.data.image }}" alt="{{ project.data.title }}">
            {% else %}
              <div class="placeholder">{{ loop.index | timecode }}</div>
            {% endif %}
          </div>
          <div class="project-meta">
            <h3>{{ project.data.title }}</h3>
            <span class="tc">{{ project.data.date | readableDate }}</span>
          </div>
          <p>{{ project.data.summary }}</p>
          <div class="tag-row">
            {% for cat in project.data.categories %}
              <span class="tag">{{ cat }}</span>
            {% endfor %}
          </div>
        </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
